# Copy to .env and adjust. Never commit the real .env.

# --- Shared secrets ---
# HS256 shared secret used by auth-service, node-auth-stub, and trade-api to sign/verify JWTs.
JWT_SECRET=change-me-dev-secret-please-rotate
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Postgres (system of record) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=trading
POSTGRES_USER=trading_app
POSTGRES_PASSWORD=change-me-dev-password
POSTGRES_ANALYTICS_READER_PASSWORD=change-me-analytics-password

# --- Kafka ("EC2" host, simulated locally on its own compose stack/network) ---
# Point this at the real EC2 public IP:9092 when you cut over; no app code changes needed.
KAFKA_BOOTSTRAP_SERVERS=kafka-ec2:29092
KAFKA_TOPIC_ORDERS=orders
KAFKA_TOPIC_TRADE_EVENTS=trade-events
KAFKA_TOPIC_MARKET_DATA=market-data

# --- Fauxnance mock ---
FAUXNANCE_BASE_URL=http://fauxnance-mock:5000
FAUXNANCE_API_KEY=dev-fauxnance-key
FAUXNANCE_DAILY_LIMIT=2000

# --- CORS ---
# Comma-separated origin patterns ("*" wildcards allowed) trade-api will accept browser
# requests from. Defaults cover localhost plus the three private LAN ranges so the frontend
# works when opened from another device's browser at http://<this-machine-ip>:4200. Narrow
# this to your exact origin(s) before anything shared/long-lived.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://192.168.*.*:4200,http://10.*.*.*:4200,http://172.*.*.*:4200

# --- Service ports (host-side) ---
FRONTEND_PORT=4200
AUTH_SERVICE_PORT=3000
NODE_AUTH_STUB_PORT=3001
TRADE_API_PORT=8080
TRADE_EXECUTOR_PORT=8082
FAUXNANCE_MOCK_PORT=5000
ANALYTICS_DASHBOARD_PORT=8501
POSTGRES_HOST_PORT=5432
